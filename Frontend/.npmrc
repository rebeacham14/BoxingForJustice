# react-simple-maps@3.0.0's declared peerDependencies range (^16.8.0 || 17.x
# || 18.x) doesn't list React 19 yet, even though it works correctly at
# runtime (verified directly: map render, state clicks, ?state= deep links).
# Without this, a clean `npm install` (e.g. on Netlify) hits an ERESOLVE
# error and fails the build. This makes local installs and CI resolve
# dependencies the same way instead of relying on a manually-passed flag.
legacy-peer-deps=true
